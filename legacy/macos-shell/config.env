# train-guard policy. Edit this file while the supervisor is running; it rereads it every poll,
# so changes take effect within ~POLL seconds with no restart.
#
# Signals are read without sudo: power source, charge %, and battery pack
# temperature (via ioreg AppleSmartBattery). macOS handles CPU/SoC thermal
# safety on its own. These thresholds are workload policy, not hardware safety
# limits. Rationale and limitations: see ../../README.md.

POLL=20                  # seconds between checks

# Power policy.
RUN_ON_BATTERY=false     # false = pause when unplugged.
                         # true  = allowed on battery (uses BATTERY_BAND down to the floor).
BATTERY_FLOOR_PCT=30     # if RUN_ON_BATTERY=true, stop below this percentage.
BATTERY_BAND=gentle      # when running on battery: gentle (background scheduling) | full
AC_BAND=full             # when on AC power and cool: full | gentle (cooler, lower priority)

# Thermal policy: battery pack temperature in °C.
# Apple publishes a 10-35°C ambient operating range. These settings use the
# battery pack sensor instead, so they are separate policy thresholds rather
# than manufacturer safety limits.
TEMP_GENTLE_C=38         # on AC, at/above this pack temp -> request background scheduling.
TEMP_PAUSE_C=42          # at/above this -> pause entirely to cool down.
TEMP_RESUME_C=36         # resume from a thermal pause once cooled to/below this (hysteresis).

# Charging while hot.
# While charging below the cutoff and warm, request background scheduling until
# the pack reaches the cutoff or cools. macOS
# chooses the cores; taskpolicy does not guarantee efficiency-core placement.
CHARGE_COOL_UNTIL_PCT=80 # only applies while charging below this %.
TEMP_CHARGE_GENTLE_C=35  # ...and pack temp >= this -> gentle mode.
